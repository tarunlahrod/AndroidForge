<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.tarunlahrod.androidforge.ui.molecule.AppCircularImageView
        android:id="@+id/iv_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/doraemon"
        app:borderColor="@color/white"
        app:borderWidth="2dp"
        app:layout_constraintBottom_toTopOf="@id/cv_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteY="512dp" />

    <com.tarunlahrod.androidforge.ui.molecule.AppRoundedImageView
        android:id="@+id/iv_rounded"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/doraemon"
        app:borderColor="@color/white"
        app:borderWidth="2dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_image"
        app:layout_constraintEnd_toStartOf="@id/iv_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_image" />

    <com.tarunlahrod.androidforge.ui.atom.AppCardView
        android:id="@+id/cv_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/tv_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_image">

        <com.tarunlahrod.androidforge.ui.atom.AppIconView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_plane"
            app:layout_constraintBottom_toTopOf="@+id/et_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </com.tarunlahrod.androidforge.ui.atom.AppCardView>

    <com.tarunlahrod.androidforge.ui.molecule.AppIconTextView
        android:id="@+id/tv_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_error"
        android:gravity="center"
        android:text="LOGIN"
        android:textSize="16sp"
        app:endIcon="@drawable/ic_chevron_right"
        app:endIconTint="@color/white"
        app:iconTextSpacing="8dp"
        app:layout_constraintBottom_toTopOf="@+id/et_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_card"
        app:startIcon="@drawable/ic_add"
        app:startIconTint="@color/white" />

    <com.tarunlahrod.androidforge.ui.atom.AppEditText
        android:id="@+id/et_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Email"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/et_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Password"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btn_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_email" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:text="Login"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_password" />

    <ProgressBar
        android:id="@+id/progress_circular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tarunlahrod.androidforge.ui.atom.AppButton
        android:id="@+id/btn_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:elevation="0dp"
        android:text="Primary"
        android:textAllCaps="false"
        android:textColor="@color/color_primary_container"
        android:textSize="13sp"
        app:appButtonStyle="primary"
        app:layout_constraintBottom_toTopOf="@id/btn_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.tarunlahrod.androidforge.ui.atom.AppButton
        android:id="@+id/btn_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:elevation="0dp"
        android:text="Secondary"
        android:textAllCaps="false"
        android:textColor="@color/color_primary"
        android:textSize="13sp"
        app:appButtonStyle="secondary"
        app:layout_constraintBottom_toTopOf="@id/btn_destructive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.tarunlahrod.androidforge.ui.atom.AppIconButton
        android:id="@+id/btn_destructive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="32dp"
        android:elevation="0dp"
        android:enabled="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="Quick Login"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:appButtonStyle="destructive"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_plane"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>